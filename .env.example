# Plausible Analytics tracker URL (site-specific). When unset, the script
# is omitted from the build and no analytics are loaded.
# Get this from your Plausible dashboard → Site settings → Snippet.
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/pa-XXXXXXXXXXXXXXXXXX.js

# Contact form endpoint: the public URL of the Scaleway function in
# functions/contact (see docs/contact-function.html). When unset, the form
# falls back to opening a mailto: link to SITE.email in the visitor's mail app.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://XXXXXXXX-contact.functions.fnc.fr-par.scw.cloud
